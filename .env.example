# Copy to .env for local runs. All values are optional; the defaults are shown.

# Port and interface for the Node server (and the built SPA it serves).
PORT=8787
HOST=0.0.0.0

# SQLite database and uploaded images live here. Relative paths resolve from the working directory.
DATA_DIR=./data

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=0

# Room lifecycle. Set ROOM_TTL_DAYS, HOST_TRANSFER_DAYS or
# ORPHAN_UPLOAD_GRACE_HOURS to 0 to disable that sweep.
ROOM_TTL_DAYS=30
HOST_TRANSFER_DAYS=14
MAINTENANCE_INTERVAL_MINUTES=60
ORPHAN_UPLOAD_GRACE_HOURS=24

# Upload budgets in megabytes. The per-room budget covers the current image.
MAX_TOTAL_UPLOAD_MB=2048
MAX_ROOM_UPLOAD_MB=24

# Set a long random value to expose GET /api/metrics with a bearer token.
# METRICS_TOKEN=
# Set to 1 only when HTTPS terminates in front of this process.
# HSTS=1
# Set to silent to suppress structured JSON logs.
# LOG_LEVEL=silent
