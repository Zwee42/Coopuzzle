# Copy to .env for local runs. All values are optional; the defaults are shown.

# Port and interface for the Node server (and the built SPA it serves).
PORT=8787
HOST=0.0.0.0

# SQLite database and uploaded images live here. Relative paths resolve from the working directory.
DATA_DIR=./data

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=0
